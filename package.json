{
  "name": "hayden-dev",
  "private": true,
  "scripts": {
    "dev": "hugo server -D",
    "build": "hugo --gc --minify --cleanDestinationDir",
    "hugo": "hugo",
    "worker:dev": "wrangler dev --config workers/api/wrangler.toml",
    "worker:deploy": "wrangler deploy --config workers/api/wrangler.toml",
    "worker:login": "wrangler login --device --browser=false",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "hugo-bin": "^0.163.0",
    "wrangler": "^4.142.0"
  },
  "hugo-bin": {
    "buildTags": "extended",
    "version": "0.154.5"
  }
}
